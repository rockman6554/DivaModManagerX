<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Miku-themed accent overrides -->
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource MikuAccentBrush}"/>
        <Setter Property="Foreground" Value="Black"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource MikuAccentDarkBrush}"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="#A33"/>
        <Setter Property="Foreground" Value="White"/>
        <Setter Property="Padding" Value="16,8"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="TextBlock.header">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="Foreground" Value="{DynamicResource MikuAccentBrush}"/>
    </Style>

    <Style Selector="TextBlock.title">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="20"/>
    </Style>

    <Style Selector="Panel.surface">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundAlt}"/>
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource PanelBackground}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Padding" Value="12"/>
    </Style>

    <Style Selector="DataGridRow">
        <Setter Property="Background" Value="Transparent"/>
    </Style>
    <Style Selector="DataGridRow:pointerover /template/ Border">
        <Setter Property="Background" Value="#223836"/>
    </Style>
    <Style Selector="DataGridRow:selected /template/ Border">
        <Setter Property="Background" Value="{DynamicResource MikuAccentDarkBrush}"/>
    </Style>

    <Style Selector="ListBoxItem">
        <Setter Property="Padding" Value="6,2"/>
    </Style>
</Styles>
